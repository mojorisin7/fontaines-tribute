---
// Full-width crossfading slider for the top of the home page.
// Autoplays every few seconds, pauses on hover or keyboard focus, and stays put
// for visitors who have reduced motion switched on.
import { slides } from '../config';
import { loadGigs, nextGig, formatDate } from '../lib/gigs';
import Logo from './Logo.astro';

// One "Next stop" per possible gig; the build shows the next for the build date and the browser
// re-picks it for the visitor's date (src/lib/gig-dates.ts).
const gigs = loadGigs();
const candidates = gigs.filter((g) => g.status !== 'cancelled');
const next = nextGig(gigs);
---

<section class="hero-slider full-bleed" aria-roledescription="carousel" aria-label="Highlights" data-interval="6000">
  {slides.map((s, i) => (
    <div
      class:list={['slide', { active: i === 0 }]}
      role="group"
      aria-roledescription="slide"
      aria-label={`${i + 1} of ${slides.length}`}
      aria-hidden={i === 0 ? undefined : 'true'}
    >
      <picture>
        {s.mobileImage && <source media="(max-width: 760px)" srcset={s.mobileImage} />}
        <img
          class="slide-img"
          src={s.image}
          alt=""
          style={`object-position: ${s.position}`}
          loading={i === 0 ? 'eager' : 'lazy'}
          fetchpriority={i === 0 ? 'high' : undefined}
        />
      </picture>
      <div class="slide-inner">
        {s.eyebrow === 'next-gig' ? (
          candidates.length > 0 && (
            <a class="slide-eyebrow slide-eyebrow-link" href="/live" data-next-group hidden={!next}>
              <svg class="pin" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2a7 7 0 0 0-7 7c0 5.2 7 13 7 13s7-7.8 7-13a7 7 0 0 0-7-7zm0 9.5A2.5 2.5 0 1 1 12 6.5a2.5 2.5 0 0 1 0 5z" fill="currentColor" /></svg>
              {candidates.map((g) => (
                <span data-date={g.date} hidden={g !== next}>Next stop: {g.city}, {formatDate(g.date, { year: undefined })}</span>
              ))}
            </a>
          )
        ) : (
          <p class="slide-eyebrow">{s.eyebrow}</p>
        )}
        {/* On phones the header has no logo, so it sits here instead (hidden on larger screens). */}
        <div class="slide-logo" aria-hidden="true"><Logo class="slide-logo-img" /></div>
        {/* Long titles get a smaller size on phones so they take about as much room as a short one. */}
        {i === 0
          ? <h1 class:list={['slide-title', { 'slide-title-long': s.title.length > 16 }]}>{s.title}</h1>
          : <p class:list={['slide-title', { 'slide-title-long': s.title.length > 16 }]}>{s.title}</p>}
        {s.text && <p class="slide-text">{s.text}</p>}
        <div class="hero-actions">
          {s.actions.map((a) => (
            <a class:list={['button', { primary: a.primary }]} href={a.href} tabindex={i === 0 ? undefined : '-1'}>
              {a.label}
            </a>
          ))}
        </div>
      </div>
    </div>
  ))}

  {slides.length > 1 && (
    <>
      <button type="button" class="slider-arrow prev" aria-label="Previous slide">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 5l-7 7 7 7" fill="none" stroke="currentColor" stroke-width="2" /></svg>
      </button>
      <button type="button" class="slider-arrow next" aria-label="Next slide">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 5l7 7-7 7" fill="none" stroke="currentColor" stroke-width="2" /></svg>
      </button>
      <div class="slider-dots">
        {slides.map((_, i) => (
          <button type="button" class="dot" aria-label={`Show slide ${i + 1}`} aria-current={i === 0 ? 'true' : undefined}></button>
        ))}
      </div>
    </>
  )}
</section>

<script>
  const root = document.querySelector<HTMLElement>('.hero-slider');
  if (root) {
    const slides = [...root.querySelectorAll<HTMLElement>('.slide')];
    const dots = [...root.querySelectorAll<HTMLButtonElement>('.dot')];
    const interval = Number(root.dataset.interval) || 6000;
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let current = 0;
    let timer: number | undefined;

    const show = (n: number) => {
      current = (n + slides.length) % slides.length;
      slides.forEach((s, i) => {
        const on = i === current;
        s.classList.toggle('active', on);
        if (on) s.removeAttribute('aria-hidden');
        else s.setAttribute('aria-hidden', 'true');
        s.querySelectorAll('a').forEach((a) => (on ? a.removeAttribute('tabindex') : a.setAttribute('tabindex', '-1')));
      });
      dots.forEach((d, i) => (i === current ? d.setAttribute('aria-current', 'true') : d.removeAttribute('aria-current')));
    };

    const stop = () => window.clearInterval(timer);
    const start = () => {
      stop();
      if (!reduced && slides.length > 1) timer = window.setInterval(() => show(current + 1), interval);
    };

    dots.forEach((d, i) => d.addEventListener('click', () => { show(i); start(); }));
    root.querySelector('.slider-arrow.prev')?.addEventListener('click', () => { show(current - 1); start(); });
    root.querySelector('.slider-arrow.next')?.addEventListener('click', () => { show(current + 1); start(); });
    root.addEventListener('mouseenter', stop);
    root.addEventListener('mouseleave', start);
    root.addEventListener('focusin', stop);
    root.addEventListener('focusout', start);
    root.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight') show(current + 1);
      if (e.key === 'ArrowLeft') show(current - 1);
    });

    // Swipe on touch screens.
    let x0: number | null = null;
    root.addEventListener('touchstart', (e) => { x0 = e.touches[0].clientX; stop(); }, { passive: true });
    root.addEventListener('touchend', (e) => {
      if (x0 === null) return;
      const dx = e.changedTouches[0].clientX - x0;
      if (Math.abs(dx) > 40) show(current + (dx < 0 ? 1 : -1));
      x0 = null;
      start();
    });

    start();
  }
</script>
