---
// Full-width crossfading slider for the top of the home page.
// Autoplays every few seconds, pauses on hover or keyboard focus, and stays put
// for visitors who have reduced motion switched on.
import { slides } from '../config';
---

<section class="hero-slider full-bleed" aria-roledescription="carousel" aria-label="Highlights" data-interval="6000">
  {slides.map((s, i) => (
    <div
      class:list={['slide', { active: i === 0 }]}
      role="group"
      aria-roledescription="slide"
      aria-label={`${i + 1} of ${slides.length}`}
      aria-hidden={i === 0 ? undefined : 'true'}
    >
      <img
        src={s.image}
        alt=""
        style={`object-position: ${s.position}`}
        loading={i === 0 ? 'eager' : 'lazy'}
        fetchpriority={i === 0 ? 'high' : undefined}
      />
      <div class="slide-inner">
        <p class="eyebrow">{s.eyebrow}</p>
        {i === 0 ? <h1 class="slide-title">{s.title}</h1> : <p class="slide-title">{s.title}</p>}
        <p class="slide-text">{s.text}</p>
        <div class="hero-actions">
          {s.actions.map((a) => (
            <a class:list={['button', { primary: a.primary }]} href={a.href} tabindex={i === 0 ? undefined : '-1'}>
              {a.label}
            </a>
          ))}
        </div>
      </div>
    </div>
  ))}

  {slides.length > 1 && (
    <div class="slider-dots">
      {slides.map((_, i) => (
        <button type="button" class="dot" aria-label={`Show slide ${i + 1}`} aria-current={i === 0 ? 'true' : undefined}>
          {String(i + 1).padStart(2, '0')}
        </button>
      ))}
    </div>
  )}
</section>

<script>
  const root = document.querySelector<HTMLElement>('.hero-slider');
  if (root) {
    const slides = [...root.querySelectorAll<HTMLElement>('.slide')];
    const dots = [...root.querySelectorAll<HTMLButtonElement>('.dot')];
    const interval = Number(root.dataset.interval) || 6000;
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let current = 0;
    let timer: number | undefined;

    const show = (n: number) => {
      current = (n + slides.length) % slides.length;
      slides.forEach((s, i) => {
        const on = i === current;
        s.classList.toggle('active', on);
        if (on) s.removeAttribute('aria-hidden');
        else s.setAttribute('aria-hidden', 'true');
        s.querySelectorAll('a').forEach((a) => (on ? a.removeAttribute('tabindex') : a.setAttribute('tabindex', '-1')));
      });
      dots.forEach((d, i) => (i === current ? d.setAttribute('aria-current', 'true') : d.removeAttribute('aria-current')));
    };

    const stop = () => window.clearInterval(timer);
    const start = () => {
      stop();
      if (!reduced && slides.length > 1) timer = window.setInterval(() => show(current + 1), interval);
    };

    dots.forEach((d, i) => d.addEventListener('click', () => { show(i); start(); }));
    root.addEventListener('mouseenter', stop);
    root.addEventListener('mouseleave', start);
    root.addEventListener('focusin', stop);
    root.addEventListener('focusout', start);
    root.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight') show(current + 1);
      if (e.key === 'ArrowLeft') show(current - 1);
    });

    // Swipe on touch screens.
    let x0: number | null = null;
    root.addEventListener('touchstart', (e) => { x0 = e.touches[0].clientX; stop(); }, { passive: true });
    root.addEventListener('touchend', (e) => {
      if (x0 === null) return;
      const dx = e.changedTouches[0].clientX - x0;
      if (Math.abs(dx) > 40) show(current + (dx < 0 ? 1 : -1));
      x0 = null;
      start();
    });

    start();
  }
</script>
