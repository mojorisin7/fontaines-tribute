---
// Quote cards from src/data/testimonials.json: { "quote": "...", "name": "...", "role": "Venue, City" }.
// Pass `limit` to show only the first few. While the file is empty, shows "Awaiting content" markers.
import Awaiting from './Awaiting.astro';
import testimonials from '../data/testimonials.json';

interface Props {
  limit?: number;
}

interface Testimonial { quote: string; name: string; role?: string }
const { limit } = Astro.props;
const list = (testimonials as Testimonial[]).slice(0, limit);
const placeholders = Array.from({ length: limit ?? 3 }, (_, i) => i);
---

<div class="testimonials">
  {list.length > 0
    ? list.map((t) => (
        <figure class="testimonial">
          <blockquote>{t.quote}</blockquote>
          <figcaption>
            <span class="testimonial-name">{t.name}</span>
            {t.role && <span class="muted">{t.role}</span>}
          </figcaption>
        </figure>
      ))
    : placeholders.map(() => <Awaiting label="A quote from a venue, promoter or fan, with their name and where they saw the band." />)}
</div>
