---
// Renders a Leaflet map of gigs (blue flags for upcoming, grey for past) with an Upcoming/Past
// toggle under it. The toggle swaps the flags and shows the page's matching [data-gig-view]
// block (e.g. the gig lists on the Live page). Defaults to upcoming.
// Gigs are passed in as props, so the same component works whether they come
// from the JSON file (Tier 1) or from Supabase (Tier 2).
// Pass every gig: the browser splits them into upcoming and past by the visitor's date.
import { formatDate, type Gig } from '../lib/gigs';

interface Props {
  gigs: Gig[];
}

const { gigs } = Astro.props;
const mapped = gigs
  .filter((g) => g.status !== 'cancelled')
  .map((g) => ({ iso: g.date, venue: g.venue, city: g.city, date: formatDate(g.date), lat: g.lat, lng: g.lng, ticketUrl: g.ticketUrl }));

// Same shape as the map flags, for the toggle under the map.
const keyFlag = (fill: string) =>
  `<svg width="18" height="22" viewBox="0 0 44 54" aria-hidden="true"><line x1="7" y1="3" x2="7" y2="51" stroke="#fbfbf7" stroke-width="5" stroke-linecap="round"/><path d="M8.5 4.5 L40 14 L8.5 24 Z" fill="${fill}" stroke="#fbfbf7" stroke-width="2" stroke-linejoin="round"/></svg>`;
---

{mapped.length > 0 && (
  <div class="gig-map-wrap">
    <div id="gig-map" class="gig-map" role="region" aria-label="Map of gigs" data-gigs={JSON.stringify(mapped)}></div>
    <div class="gig-view-toggle" role="group" aria-label="Show gigs" hidden>
      <button type="button" data-view="upcoming" aria-pressed="true"><Fragment set:html={keyFlag('#1966cb')} /> Upcoming</button>
      <button type="button" data-view="past" aria-pressed="false"><Fragment set:html={keyFlag('#8f8f8a')} /> Past</button>
    </div>
  </div>
)}

<script>
  import L from 'leaflet';
  import 'leaflet/dist/leaflet.css';
  import { today } from '../lib/gig-dates';

  const el = document.getElementById('gig-map');
  if (el) {
    type MapGig = { iso: string; venue: string; city: string; date: string; lat: number; lng: number; ticketUrl: string };
    const gigs: MapGig[] = JSON.parse(el.dataset.gigs || '[]');
    type View = 'upcoming' | 'past';
    const viewOf = (g: MapGig): View => (g.iso < today ? 'past' : 'upcoming');

    // UK-wide view. The toggle returns to it, and only zooms out if flags fall outside it.
    const home = { center: [53.8, -1.55] as [number, number], zoom: 6 };
    const map = L.map(el, { scrollWheelZoom: false }).setView(home.center, home.zoom);

    L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', {
      maxZoom: 18,
      attribution: '&copy; OpenStreetMap contributors',
    }).addTo(map);

    // Coloured flag on a dark pole, with a white edge so it stands out on light and busy map areas.
    const flag = (fill: string) =>
      L.divIcon({
        className: 'flag-pin',
        html:
          '<svg width="44" height="54" viewBox="0 0 44 54" xmlns="http://www.w3.org/2000/svg">' +
          '<line x1="7" y1="3" x2="7" y2="51" stroke="#fff" stroke-width="6" stroke-linecap="round"/>' +
          '<line x1="7" y1="3" x2="7" y2="51" stroke="#111" stroke-width="3" stroke-linecap="round"/>' +
          `<path d="M8.5 4.5 L40 14 L8.5 24 Z" fill="${fill}" stroke="#fff" stroke-width="2" stroke-linejoin="round"/>` +
          '<circle cx="7" cy="51" r="3" fill="#111" stroke="#fff" stroke-width="1.5"/></svg>',
        iconSize: [44, 54],
        iconAnchor: [7, 51],
        popupAnchor: [14, -46],
      });
    const upcomingFlag = flag('#1966cb');
    const pastFlag = flag('#8f8f8a');

    // Build popups with DOM nodes, not HTML strings, so Tier 2 user input can't inject markup.
    const popup = (g: MapGig, past: boolean) => {
      const div = document.createElement('div');
      const name = document.createElement('strong');
      name.textContent = g.venue;
      div.append(name, document.createElement('br'), `${g.city}, ${g.date}`);
      if (past) {
        const note = document.createElement('em');
        note.textContent = 'Past gig';
        div.append(document.createElement('br'), note);
      } else if (g.ticketUrl) {
        const a = document.createElement('a');
        a.href = g.ticketUrl;
        a.target = '_blank';
        a.rel = 'noopener';
        a.textContent = 'Tickets';
        div.append(document.createElement('br'), a);
      }
      return div;
    };

    const layers = { upcoming: L.layerGroup(), past: L.layerGroup() };
    const bounds: Record<View, [number, number][]> = { upcoming: [], past: [] };
    for (const g of gigs) {
      const view = viewOf(g);
      const past = view === 'past';
      L.marker([g.lat, g.lng], { icon: past ? pastFlag : upcomingFlag, title: g.venue })
        .addTo(layers[view])
        .bindPopup(popup(g, past));
      bounds[view].push([g.lat, g.lng]);
    }

    const toggle = el.parentElement!.querySelector<HTMLElement>('.gig-view-toggle')!;
    const buttons = [...toggle.querySelectorAll<HTMLButtonElement>('button[data-view]')];

    const show = (view: View) => {
      for (const v of ['upcoming', 'past'] as const) {
        if (v === view) layers[v].addTo(map);
        else layers[v].remove();
      }
      map.setView(home.center, home.zoom, { animate: false });
      const b = bounds[view];
      if (!b.every((p) => map.getBounds().contains(p))) map.fitBounds(b, { padding: [40, 40], maxZoom: home.zoom });
      for (const btn of buttons) btn.setAttribute('aria-pressed', String(btn.dataset.view === view));
      for (const block of document.querySelectorAll<HTMLElement>('[data-gig-view]')) {
        block.hidden = block.dataset.gigView !== view;
      }
    };

    for (const btn of buttons) btn.addEventListener('click', () => show(btn.dataset.view as View));
    // Only offer the toggle once there are past gigs to switch to.
    toggle.hidden = bounds.past.length === 0;
    show('upcoming');
  }
</script>
