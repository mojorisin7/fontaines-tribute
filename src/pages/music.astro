---
import Base from '../layouts/Base.astro';
import music from '../data/music.json';
import { formatDate } from '../lib/gigs';

// Album covers in a grid, newest first, laid out like the band's own music page.
// Edit src/data/music.json:
//   "releases": [{ "title": "Album name", "date": "YYYY-MM-DD", "cover": "/music/file.webp" }]
// Covers live in public/music/ (square images, 600-1000px).
interface Release { title: string; date: string; cover: string }
const releases = music.releases as Release[];
---

<Base title="Music" description="The Fontaines D.C. albums we play from.">
  <h1 class="music-heading">Music</h1>

  <div class="releases">
    {releases.map((r) => (
      <div class="release">
        <img class="release-cover" src={r.cover} alt={`${r.title} album cover`} width="1000" height="1000" loading="lazy" decoding="async" />
        <h3 class="release-title">{r.title}</h3>
        <p class="release-date">{formatDate(r.date, { month: 'long' })}</p>
      </div>
    ))}
  </div>
</Base>
