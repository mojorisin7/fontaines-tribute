---
import Base from '../layouts/Base.astro';

// Placeholder line-up. Replace names and roles with the client's.
const lineup = [
  { name: 'Name', role: 'Vocals' },
  { name: 'Name', role: 'Guitar' },
  { name: 'Name', role: 'Guitar' },
  { name: 'Name', role: 'Bass' },
  { name: 'Name', role: 'Drums' },
];
---

<Base title="About" description="Who we are and what we play.">
  <h1>About</h1>
  <div class="prose">
    <p class="lead">Band bio goes here, written by the client.</p>
    <p>A second paragraph: how the band started, the kind of set they play, the venues they suit.</p>
  </div>

  <h2>The line-up</h2>
  <ul class="lineup">
    {lineup.map((m) => (
      <li><span class="lineup-name">{m.name}</span><span class="muted">{m.role}</span></li>
    ))}
  </ul>
</Base>
