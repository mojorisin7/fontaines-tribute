---
import Base from '../layouts/Base.astro';
import GigList from '../components/GigList.astro';
import Ticker from '../components/Ticker.astro';
import HeroSlider from '../components/HeroSlider.astro';
import Testimonials from '../components/Testimonials.astro';
import { loadGigs, upcomingGigs, nextGig, formatDate } from '../lib/gigs';

const gigs = loadGigs();
const next = nextGig(gigs);
const soon = upcomingGigs(gigs).slice(0, 5);
const tickerItems = soon
  .filter((g) => g.status !== 'cancelled')
  .map((g) => `${g.city} ${formatDate(g.date, { year: undefined })}`);
---

<Base title="Home" overlayHeader>
  <HeroSlider />

  {tickerItems.length > 0 && <Ticker items={tickerItems} />}

  {next && (
    <section class="next-gig">
      <div>
        <p class="eyebrow">Next gig</p>
        <p class="next-gig-date">{formatDate(next.date, { weekday: 'short', month: 'long' })}</p>
        <p class="next-gig-venue caps">{next.venue}, {next.city}</p>
      </div>
      {next.ticketUrl
        ? <a class="button primary" href={next.ticketUrl} rel="noopener" target="_blank">Tickets</a>
        : <a class="button" href="/live">Details</a>}
    </section>
  )}

  <section>
    <h2>Live <a href="/live">Show all dates</a></h2>
    <GigList gigs={soon} />
  </section>

  <section>
    <h2>What people say <a href="/testimonials">Read more</a></h2>
    <Testimonials limit={2} />
  </section>

  <section class="book-banner">
    <p class="eyebrow">Bookings</p>
    <p class="book-banner-title">Book the band</p>
    <p>Venues, festivals and private parties.</p>
    <a class="button primary" href="/book">Get in touch</a>
  </section>
</Base>
