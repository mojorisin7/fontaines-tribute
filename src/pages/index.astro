---
import Base from '../layouts/Base.astro';
import GigList from '../components/GigList.astro';
import Ticker from '../components/Ticker.astro';
import HeroSlider from '../components/HeroSlider.astro';
import Testimonials from '../components/Testimonials.astro';
import { loadGigs, nextGig, formatDate } from '../lib/gigs';

const gigs = loadGigs();
// Every gig that could be "next"; the build shows the next one for the build date and the
// browser re-picks it for the visitor's date (src/lib/gig-dates.ts).
const candidates = gigs.filter((g) => g.status !== 'cancelled');
const next = nextGig(gigs);
---

<Base title="Home" overlayHeader>
  <HeroSlider />

  <Ticker gigs={gigs} />

  {candidates.length > 0 && (
    <div data-next-group hidden={!next}>
      {candidates.map((g) => (
        <section class="next-gig" data-date={g.date} hidden={g !== next}>
          <div>
            <p class="eyebrow">Next gig</p>
            <p class="next-gig-date">{formatDate(g.date, { weekday: 'short', month: 'long' })}</p>
            <p class="next-gig-venue caps">{g.venue}, {g.city}</p>
          </div>
          {g.ticketUrl
            ? <a class="button primary" href={g.ticketUrl} rel="noopener" target="_blank">Tickets</a>
            : <a class="button" href="/live">Details</a>}
        </section>
      ))}
    </div>
  )}

  <section>
    <h2>Live <a href="/live">Show all dates</a></h2>
    <GigList gigs={gigs} limit={5} />
  </section>

  <section>
    <h2>What people say <a href="/testimonials">Read more</a></h2>
    <Testimonials limit={2} />
  </section>

  <section class="book-banner">
    <p class="eyebrow">Bookings</p>
    <p class="book-banner-title">Book the band</p>
    <p>Venues, festivals and private parties.</p>
    <a class="button primary" href="/book">Get in touch</a>
  </section>
</Base>
