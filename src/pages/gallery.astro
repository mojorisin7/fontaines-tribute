---
import Base from '../layouts/Base.astro';
import photos from '../data/photos.json';

// Tier 1: drop images in public/photos/ and list them in src/data/photos.json as
// { "src": "/photos/leeds.jpg", "alt": "Band on stage at the Brudenell", "caption": "Leeds, Nov 2026" }
// Tier 2: these come from Supabase Storage instead.
interface Photo { src: string; alt: string; caption?: string }
const list = photos as Photo[];
---

<Base title="Gallery" description="Photos from the gigs.">
  <h1>Gallery</h1>
  {list.length === 0 ? (
    <>
      <p class="muted">Photos coming soon.</p>
      <div class="gallery-grid">
        {[1, 2, 3, 4, 5, 6].map((n) => <div class="placeholder">PHOTO {n}</div>)}
      </div>
    </>
  ) : (
    <div class="gallery-grid">
      {list.map((p) => (
        <figure>
          <a href={p.src}><img src={p.src} alt={p.alt} loading="lazy" /></a>
          {p.caption && <figcaption>{p.caption}</figcaption>}
        </figure>
      ))}
    </div>
  )}
</Base>
