---
import Base from '../layouts/Base.astro';
import GigMap from '../components/GigMap.astro';
import GigList from '../components/GigList.astro';
import { loadGigs, pastGigs } from '../lib/gigs';

// Lists and map get every gig and pick upcoming/past by date (build date, then the visitor's).
const gigs = loadGigs();
const pastAtBuild = pastGigs(gigs).filter((g) => g.status !== 'cancelled');
---

<Base title="Live" description="Upcoming and past gig dates.">
  <h1>Live</h1>

  <GigMap gigs={gigs} />

  <h2>Upcoming</h2>
  <GigList gigs={gigs} />

  <div data-gig-section hidden={pastAtBuild.length === 0}>
    <h2>Past gigs</h2>
    <GigList gigs={gigs} past />
  </div>
</Base>
